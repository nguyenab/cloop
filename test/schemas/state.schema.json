{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cloop state file",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "status", "iteration", "started_at", "stop_after", "cron_job_id"],
  "properties": {
    "slug": {"type": "string"},
    "status": {"enum": ["running", "stopped", "done"]},
    "iteration": {"type": "integer", "minimum": 0},
    "started_at": {"type": "string"},
    "stop_after": {"type": ["string", "integer"]},
    "cron_job_id": {"type": ["string", "null"]}
  }
}
